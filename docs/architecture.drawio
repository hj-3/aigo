        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===== PAGE 4: Incident Investigation Flow ===== -->
  <diagram id="Incident-Flow" name="인시던트 조사 플로우">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
