        <mxCell id="if_s1" value="① CloudWatch Alarm 발생 (Lambda 에러율 &gt;1%, API 지연 p99 &gt;10s, DLQ 메시지 등)" style="rounded=1;fillColor=#FDF2F8;strokeColor=#9D174D;fontColor=#1A1A2E;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="128" y="84" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_icon2" value="" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;fillColor=#E7157B;labelBackgroundColor=none;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1">
          <mxGeometry x="60" y="172" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_s2" value="② EventBridge 규칙 매칭 (GuardDuty severity≥7 또는 CloudWatch 상태 전환) → aws-event-connector 트리거" style="rounded=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#1A1A2E;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="128" y="172" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_icon3" value="" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;fillColor=#ED7100;labelBackgroundColor=none;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_s3" value="③ aws-event-connector: Incident 레코드 생성 (DynamoDB Incidents) + SQS incident-queue 발행" style="rounded=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#1A1A2E;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="128" y="260" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_icon4" value="" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;fillColor=#ED7100;labelBackgroundColor=none;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="60" y="348" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_s4" value="④ lightweight-worker: SQS 소비 → Incident Job PENDING→IN_PROGRESS → AgentCore 호출 (Incident Agent)" style="rounded=1;fillColor=#FFE4E6;strokeColor=#DC2626;fontColor=#1A1A2E;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="128" y="348" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_icon5" value="" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;fillColor=#01A88D;labelBackgroundColor=none;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="60" y="436" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_s5" value="⑤ Incident Agent (OODA Loop): Observe → Orient → Decide → Act" style="rounded=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#1A1A2E;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="128" y="436" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_icon6" value="" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;fillColor=#E7157B;labelBackgroundColor=none;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="60" y="524" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_s6" value="⑥ 조사 수행: CloudWatch 메트릭 + X-Ray 트레이스 + CloudTrail 이벤트 조회 (aws_observability_tools)" style="rounded=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#1A1A2E;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="128" y="524" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_icon7" value="" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;fillColor=#C7131F;labelBackgroundColor=none;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="60" y="612" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_s7" value="⑦ RCA 리포트 생성 → DynamoDB Incidents 업데이트 + S3 incidents/{orgId}/{incidentId}/rca.md 저장" style="rounded=1;fillColor=#F0FDF4;strokeColor=#15803D;fontColor=#1A1A2E;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="128" y="612" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_icon8" value="" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;fillColor=#ED7100;labelBackgroundColor=none;align=center;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_s8" value="⑧ SQS notification-queue → notification-worker → Slack INCIDENT_DETECTED + Dashboard 타임라인 업데이트" style="rounded=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#1A1A2E;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="128" y="700" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if_a1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="if_s1" target="if_s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="if_a2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="if_s2" target="if_s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="if_a3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="if_s3" target="if_s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="if_a4" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="if_s4" target="if_s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="if_a5" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="if_s5" target="if_s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="if_a6" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="if_s6" target="if_s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="if_a7" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="if_s7" target="if_s8"><mxGeometry relative="1" as="geometry" /></mxCell>
