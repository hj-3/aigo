        </mxCell>
        <mxCell id="if_right_title" value="OODA Loop 상세 (Google SRE 방법론)" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1">
          <mxGeometry x="736" y="82" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="if_observe" value="Observe (관찰)" style="rounded=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1D4ED8;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="736" y="120" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="if_ob1" value="• CloudWatch 메트릭 수집&#xa;• X-Ray 트레이스 분석&#xa;• CloudTrail 이벤트 조회&#xa;• 알람 발생 시점 확인" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="736" y="168" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="if_orient" value="Orient (분석)" style="rounded=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#7C3AED;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="736" y="256" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="if_or1" value="• 근본 원인 추론 (RCA)&#xa;• 영향 범위 파악&#xa;• 과거 장애 패턴 비교&#xa;• 우선순위 판단" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="736" y="304" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="if_decide" value="Decide (결정)" style="rounded=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#D97706;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="736" y="392" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="if_de1" value="• 해결 방안 목록 생성&#xa;• 위험도 / 효과 평가&#xa;• 우선 조치 선택&#xa;• 알림 채널 결정" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="736" y="440" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="if_act" value="Act (실행 권고)" style="rounded=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#16A34A;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
