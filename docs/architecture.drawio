        </mxCell>
        <mxCell id="af_out_db2" value="Dashboard 상태 업데이트&#xa;FixCenter: PATCH_READY → APPLIED" style="rounded=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
