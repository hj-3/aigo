        </mxCell>
        <mxCell id="af_sl1" value="Slack /approve {reportId} → slack-connector → 서명 검증 → command-queue → dashboard-cmd 동일 처리" style="text;html=1;align=left;strokeColor=none;fillColor=none;fontSize=11;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="682" y="576" width="800" height="18" as="geometry" />
        </mxCell>
        <mxCell id="af_vpc_note" value="보안: heavy-worker ECS는 VPC Private Subnet. NAT를 통해 GitHub API 접근. Secrets Manager로 GitHub App 인증 정보 조회." style="rounded=1;fillColor=#F0F9FF;strokeColor=#0EA5E9;fontColor=#0369A1;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
