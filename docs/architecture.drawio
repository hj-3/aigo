        <mxCell id="if_title" value="인시던트 자동 조사 플로우 (OODA Loop)" style="text;html=1;align=center;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1">
          <mxGeometry x="200" y="16" width="1000" height="36" as="geometry" />
