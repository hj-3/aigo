# Cognito — values from `terraform output` in infra/terraform/envs/prod
VITE_COGNITO_USER_POOL_ID=ap-northeast-2_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=aigo.auth.ap-northeast-2.amazoncognito.com

# OAuth redirect URLs — must match Cognito app client callback/logout URLs
VITE_REDIRECT_SIGN_IN=https://app.your-domain.com/
VITE_REDIRECT_SIGN_OUT=https://app.your-domain.com/

# API Gateway invoke URL from `terraform output api_endpoint`
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-northeast-2.amazonaws.com/prod
