{
  "name": "@aigo/connector-aws-event",
  "version": "1.0.0",
  "private": true,
  "description": "AWS Event connector Lambda (CloudWatch Alarm → Incident)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --external:@aws-sdk/*",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aigo/aws-clients": "workspace:*",
    "@aigo/logger": "workspace:*",
    "@aigo/types": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
